# Deal Hunter - Environment Configuration Template

# Database
DB_PATH=data/deals.db

# Crawler Engine (mock, feed, or playwright)
FETCH_MODE=playwright

# Deal Detection Criteria
DEAL_MIN_DISCOUNT=30
DEAL_MIN_RATING=4.0
SCAN_INTERVAL_MIN=30
REQUEST_DELAY_SEC=8

# Captcha Solver (NopeCHA - Free 100 solves/day)
NOPECHA_API_KEY=

# Affiliate Links Template ({raw} or {url})
AFF_SHOPEE={raw}

# Telegram Bot & Channel
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Web Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=5000
