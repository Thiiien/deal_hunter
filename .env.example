# Deal Hunter - Environment Configuration Template
# Giá trị bên dưới là mặc định trong src/deal_hunter/config.py.
# Lưu ý: tần suất quét, công tắc phân hệ, ngưỡng giá và chế độ thông báo
# còn được lưu trong bảng settings của SQLite (sửa qua Dashboard/Bot) và
# giá trị trong DB ghi đè giá trị ở đây khi khởi động.

# Database
DB_PATH=data/deals.db

# Crawler Engine (mock, feed, or playwright)
FETCH_MODE=playwright
EXTENSIONS_DIR=extensions
# Chrome thật qua CDP (ADR 0063, đã rút lại ở ADR 0064). Để trống = headless trong Docker.
CDP_URL=

# Deal Detection Criteria
DEAL_MIN_DISCOUNT=30
DEAL_MIN_RATING=4.0
DEAL_MIN_ORIGINAL_PRICE=500000

# Scheduler (phút) và độ trễ giữa 2 sản phẩm (giây)
SCAN_INTERVAL_MIN=2
REQUEST_DELAY_SEC=5
BLOCK_IMAGES=1   # thử nghiệm: chặn ảnh trang Lazada, đặt 0 nếu captcha tăng

# Telegram: chỉ báo khi chạm giá mong muốn (ADR 0062). 0 = báo cả giảm giá, deal thật, lỗi giá
ONLY_TARGET_PRICE_ALERTS=1

# Phân hệ khám phá (ADR 0055: mặc định tắt, bật lại trong Cài đặt dashboard)
KEYWORD_SCAN_ENABLED=0
MEGASALE_SCAN_ENABLED=0
PRICE_ERROR_SCAN_ENABLED=0
TMALL_SCAN_ENABLED=0
KEYWORD_INTERVAL_MIN=180
MEGASALE_INTERVAL_MIN=60
PRICE_ERROR_INTERVAL_MIN=60
TMALL_INTERVAL_MIN=120
KEYWORD_RESULT_LIMIT=30
KEYWORD_INCLUDE_UNKNOWN=0
TMALL_MIN_PRICE=100000
TMALL_MAX_PRICE=20000000

# Captcha Solver: NopeCHA extension miễn phí 10 lượt/ngày không cần key (ADR 0048);
# có key thì dùng số dư tài khoản.
NOPECHA_API_KEY=

# Affiliate Links Template ({raw} = link gốc, {url} = link đã mã hóa)
AFF_SHOPEE={raw}
AFF_LAZADA={raw}
AFF_TIKTOK={raw}

# Telegram Bot & Channel
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Web Dashboard (không có đăng nhập: chỉ mở ra ngoài 127.0.0.1 khi đã thêm xác thực)
# Trong Docker, docker-compose đã bind cổng về 127.0.0.1 phía host.
WEB_HOST=127.0.0.1
WEB_PORT=5000
